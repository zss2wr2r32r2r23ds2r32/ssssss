{
  "name": "haven-process-manager",
  "version": "1.0.0",
  "description": "A Windows-first local application and process manager",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --packages=external --outdir=dist-electron",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis",
    "start": "electron ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zss2wr2r32r2r23ds2r32/ssssss.git"
  },
  "keywords": [
    "electron",
    "process-manager",
    "minecraft",
    "discord"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zss2wr2r32r2r23ds2r32/ssssss/issues"
  },
  "homepage": "https://github.com/zss2wr2r32r2r23ds2r32/ssssss#readme",
  "build": {
    "appId": "com.haven.processmanager",
    "productName": "Haven Process Manager",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "lucide-react": "^1.46.0",
    "pidusage": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "systeminformation": "^5.33.11"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/pidusage": "^2.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
