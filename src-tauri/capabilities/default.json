{
  "identifier": "default",
  "description": "Nexa main window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:4177", "http://127.0.0.1:4177/", "http://127.0.0.1:4177/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-is-maximized",
    "allow-open-external",
    "allow-pick-folder"
  ]
}
