# Discord bot token from the Developer Portal → Bot → Reset Token.
# Leave this empty until you are ready. The bot exits cleanly without it,
# and the launcher does not need a token to run.
DISCORD_TOKEN=

# Application ID (General Information → Application ID). Used to register slash commands.
DISCORD_CLIENT_ID=1558290151124369440

# Optional. Set this to a server id to register commands there immediately.
# Leave blank to register global commands (can take up to an hour to appear).
DISCORD_GUILD_ID=

# Local Nexa API. /login posts the Discord user to this API. The other commands read it.
LAUNCHER_API_URL=http://127.0.0.1:4177
